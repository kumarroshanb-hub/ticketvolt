# ===========================================================================
# BOOKING ERRORS
# ===========================================================================
msgid "The selected slot was not found."
msgstr "搵唔到所選時段。"

msgid "The selected slot does not belong to this event."
msgstr "所選時段唔屬於呢個活動。"

msgid "This slot is fully booked."
msgstr "呢個時段已經滿咗。"

msgid "Only 1 seat left in this slot."
msgstr "呢個時段仲剩返 1 個位。"

msgid "Only {available} seats left in this slot."
msgstr "呢個時段仲剩返 {available} 個位。"

msgid "At least one entry is required."
msgstr "最少要有一個登記名額。"

msgid "metadata.entries must be a positive integer."
msgstr "metadata.entries 必須係正整數。"

msgid "metadata.attendees must be a list."
msgstr "metadata.attendees 必須係一個列表。"

msgid "metadata.attendees must contain exactly {entries} entries (got {actual})."
msgstr "metadata.attendees 必須啱啱好有 {entries} 個名額（而家有 {actual} 個）。"

msgid "Entry {index} must be an object."
msgstr "名額 {index} 必須係一個物件。"

msgid "Entry {index} is missing a name."
msgstr "名額 {index} 漏咗個名。"

msgid "Entry {index} has an invalid email address."
msgstr "名額 {index} 嘅電郵地址唔啱。"

msgid "Maximum {max} entries per registration."
msgstr "每次登記最多 {max} 個名額。"

msgid "Registration is closed — all slots are full."
msgstr "登記已經截止 — 所有時段都滿咗。"

msgid "Could not issue registration passes for this booking. Please contact support."
msgstr "無法為呢個預訂發出登記通行證，請聯絡客戶服務。"

msgid "Registration could not be completed. Please try again or contact support."
msgstr "登記未能完成，請再試一次或者聯絡客戶服務。"

msgid "You do not have permission to access this booking."
msgstr "你冇權查看呢個預訂。"

msgid "Maximum 200 bookings per bulk action."
msgstr "每次批量操作最多 200 個預訂。"

msgid "No valid booking_ids provided"
msgstr "冇提供有效嘅 booking_ids"

msgid "action is required and must be a string"
msgstr "必須提供 action，而且一定要係字串"

msgid "Request body must be a JSON object"
msgstr "請求內容必須係 JSON 物件"

msgid "Invalid JSON body"
msgstr "JSON 內容無效"

msgid "Invalid action: {action!r}"
msgstr "操作無效：{action!r}"

msgid "Booking not found"
msgstr "搵唔到預訂"

msgid "No valid bookings found"
msgstr "搵唔到有效預訂"

msgid "{count} booking(s) are not eligible for {action}"
msgstr "{count} 個預訂唔符合 {action} 嘅條件"

msgid "Cannot confirm payment for cancelled booking"
msgstr "無法為已取消嘅預訂確認付款"

msgid "Cannot confirm payment for refunded booking"
msgstr "無法為已退款嘅預訂確認付款"

msgid "Booking is already completed"
msgstr "預訂已經完成"

msgid "Payment already confirmed at {when}"
msgstr "付款已經喺 {when} 確認咗"

msgid "Booking must be pending or processing. Current status: {status}"
msgstr "預訂必須係待處理或者處理中。而家嘅狀態：{status}"

msgid "This booking already has {count} active ticket(s). New tickets cannot be issued."
msgstr "呢個預訂已經有 {count} 張有效門票，唔可以再發新門票。"

msgid "Booking must be paid or confirmed. Current status: {status}"
msgstr "預訂必須係已付款或者已確認。而家嘅狀態：{status}"

msgid "Only paid or confirmed bookings can be refunded. Current status: {status}"
msgstr "只有已付款或者已確認嘅預訂先可以退款。而家嘅狀態：{status}"

msgid "Booking is already refunded"
msgstr "預訂已經退款"

msgid "Cannot refund a completed booking (all tickets already used)"
msgstr "無法為已完成嘅預訂退款（所有門票已經用咗）"

msgid "Booking has no associated event"
msgstr "預訂冇關聯活動"

msgid "Cannot process booking for cancelled event"
msgstr "無法處理已取消活動嘅預訂"

msgid "Payment confirmed successfully"
msgstr "付款確認成功"

msgid "Payment confirmed and tickets issued successfully"
msgstr "付款確認同門票發放成功"

msgid "Cannot issue tickets. Booking already has active tickets."
msgstr "無法發放門票，預訂已經有有效門票。"

msgid "No sessions available for this event. Please contact support."
msgstr "呢個活動冇可用時段，請聯絡客戶服務。"

msgid "All slots are currently full. Please contact support."
msgstr "所有時段而家都滿咗，請聯絡客戶服務。"

msgid "Allocated based on your Preference #{rank}"
msgstr "已經根據你嘅第 #{rank} 志願分配"

msgid "Allocated to next available slot (your preferred slots were full)"
msgstr "已經分配去下一個可用時段（你揀嘅時段都滿咗）"

msgid "Slot confirmed"
msgstr "時段已確認"

msgid "No slot available for this booking"
msgstr "呢個預訂冇可用時段"

msgid "Cannot issue tickets. Booking already has {count} active ticket(s)"
msgstr "無法發放門票，預訂已經有 {count} 張有效門票"

msgid "This event has no ticket tiers configured. Tickets cannot be issued until at least one tier exists."
msgstr "呢個活動未設定票種，至少要有一個票種先可以發放門票。"

msgid "No available ticket tiers found for this event. Please contact support."
msgstr "呢個活動搵唔到可用票種，請聯絡客戶服務。"

msgid "No ticket information found for this booking. Please contact support."
msgstr "呢個預訂搵唔到門票資料，請聯絡客戶服務。"

msgid "Ticket issuance incomplete: expected {expected} tickets, created {created}. {missing} attendee(s) were dropped. See server logs for details."
msgstr "門票發放未完成：預期 {expected} 張，實際建立 {created} 張，有 {missing} 位參加者被漏掉。詳情請睇伺服器日誌。"

msgid "No active tickets found to regenerate QR codes"
msgstr "搵唔到有效門票可以重新產生 QR code"

msgid "Booking cancelled successfully"
msgstr "預訂取消成功"

msgid "Booking refunded successfully"
msgstr "預訂退款成功"

msgid "No active tickets to resend"
msgstr "冇有效門票可以重新發送"

msgid "The supplied email does not match the email on this booking. If the customer has changed their email, update the booking first."
msgstr "提供嘅電郵同呢個預訂嘅電郵唔一致。如果客人改咗電郵，請先更新預訂。"

msgid "Tickets resent successfully"
msgstr "門票重新發送成功"

msgid "No active ticket to send."
msgstr "冇有效門票可以發送。"

msgid "No customer email on booking."
msgstr "預訂冇客人電郵。"

msgid "You cannot apply discounts to this booking"
msgstr "你唔可以為呢個預訂套用折扣"

msgid "discount_code is required"
msgstr "必須提供 discount_code"

msgid "Discount is not yet valid"
msgstr "折扣未開始生效"

msgid "Discount has expired"
msgstr "折扣已經過期"

msgid "Discount has reached maximum uses"
msgstr "折扣已經達到使用上限"

msgid "Invalid discount code"
msgstr "折扣代碼無效"

msgid "Invalid or inactive discount code."
msgstr "折扣代碼無效或者已經停用。"

msgid "Only staff may cancel checked-in tickets"
msgstr "只有職員先可以取消已簽到嘅門票"

msgid "ticket_ids must be a non-empty list"
msgstr "ticket_ids 必須係一個非空列表"

msgid "Booking is already {status}"
msgstr "預訂已經係 {status}"

msgid "No cancellation policy attached to this booking. Cancellation is not allowed."
msgstr "呢個預訂冇附加取消政策，唔可以取消。"

msgid "This event does not allow partial cancellation. Cancel the whole booking instead."
msgstr "呢個活動唔允許部分取消，請取消整個預訂。"

msgid "No ticket IDs provided."
msgstr "冇提供門票 ID。"

msgid "Ticket(s) not found on this booking: {ids}"
msgstr "喺呢個預訂搵唔到以下門票：{ids}"

msgid "No tickets to cancel."
msgstr "冇門票可以取消。"

