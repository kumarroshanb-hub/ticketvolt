# ===========================================================================
# AUTH / LOGIN / REGISTRATION
# ===========================================================================
msgid "Email and password required"
msgstr "請輸入電郵同密碼"

msgid "Too many failed login attempts. Please try again later."
msgstr "登入失敗次數過多，請遲啲再試。"

msgid "Invalid credentials"
msgstr "登入資料唔啱"

msgid "Username already exists"
msgstr "用戶名稱已經有人用咗"

msgid "Email already exists"
msgstr "電郵已經有人用咗"

msgid "Passwords do not match"
msgstr "兩次輸入嘅密碼唔一致"

msgid "Email is too long."
msgstr "電郵地址太長。"

msgid "Invalid phone number."
msgstr "電話號碼唔啱。"

msgid "Enter a valid mobile number (7–15 digits, optionally starting with \"+\")."
msgstr "請輸入有效嘅手機號碼（7–15 位數字，可以以「+」開頭）。"

msgid "Enter a valid WhatsApp number (7–15 digits, optionally starting with \"+\")."
msgstr "請輸入有效嘅 WhatsApp 號碼（7–15 位數字，可以以「+」開頭）。"

msgid "If an account exists with this email, a reset link has been sent."
msgstr "如果呢個電郵有登記帳戶，我哋已經發送咗重設連結。"

msgid "Failed to send email. Please try again later."
msgstr "電郵發送失敗，請遲啲再試。"

msgid "Missing required fields."
msgstr "請填寫所有必填欄位。"

msgid "Invalid or expired reset link. Please request a new one."
msgstr "重設連結無效或者過咗期，請重新申請。"

msgid "Password has been reset successfully."
msgstr "密碼重設成功。"

msgid "A new password is required."
msgstr "請輸入新密碼。"

msgid "You do not have permission to reset this password."
msgstr "你冇權重設呢個密碼。"

msgid "Only a super admin can reset a super admin password."
msgstr "只有超級管理員先可以重設超級管理員嘅密碼。"

msgid "You do not have permission to modify users"
msgstr "你冇權修改用戶資料"

msgid "You do not have permission to unlock users."
msgstr "你冇權為用戶解鎖。"

msgid "Only a super admin can unlock a super admin."
msgstr "只有超級管理員先可以為超級管理員解鎖。"

msgid "Only super admin can delete users"
msgstr "只有超級管理員先可以刪除用戶"

msgid "Only super admin can update user roles"
msgstr "只有超級管理員先可以更改用戶角色"

msgid "Only super admin can modify super admin users"
msgstr "只有超級管理員先可以修改超級管理員帳戶"

msgid "You cannot delete your own account"
msgstr "你唔可以刪除自己嘅帳戶"

msgid "Email already in use"
msgstr "呢個電郵已經俾人用咗"

msgid "Invalid role. Must be: user, organizer, admin, super_admin"
msgstr "角色唔啱，必須係：user、organizer、admin 或 super_admin"

msgid "You do not have permission to create users"
msgstr "你冇權建立用戶"

msgid "You do not have permission to edit this user."
msgstr "你冇權編輯呢個用戶。"

msgid "You do not have permission to view this profile."
msgstr "你冇權查看呢個個人檔案。"

msgid "You do not have permission to edit this profile."
msgstr "你冇權編輯呢個個人檔案。"

msgid "Password reset for {username}."
msgstr "已為 {username} 重設密碼。"

msgid "{username} unlocked."
msgstr "{username} 已解鎖。"

msgid "Permission denied."
msgstr "權限不足。"

#. ✅ NEW — Frontend ForgotPassword.js / ResetPassword.js
msgid "Forgot Password"
msgstr "忘記密碼"

msgid "Enter your email address and we'll send you a link to reset your password."
msgstr "輸入你嘅電郵地址，我哋會發送一條重設密碼嘅連結俾你。"

msgid "Send Reset Link"
msgstr "發送重設連結"

msgid "Back to Login"
msgstr "返回登入"

msgid "Return to Login"
msgstr "返回登入"

msgid "Set New Password"
msgstr "設定新密碼"

msgid "Please enter your new password below."
msgstr "請喺下面輸入你嘅新密碼。"

msgid "New Password"
msgstr "新密碼"

msgid "Confirm New Password"
msgstr "確認新密碼"

msgid "Reset Password"
msgstr "重設密碼"

msgid "Password must be at least 10 characters long."
msgstr "密碼最少要有 10 個字元。"

msgid "Passwords do not match."
msgstr "兩次輸入嘅密碼唔一致。"

msgid "Password reset successfully! You can now log in."
msgstr "密碼重設成功！你而家可以登入。"

msgid "Failed to reset password. The link may be expired."
msgstr "重設密碼失敗，連結可能已經過期。"

msgid "Reset link sent!"
msgstr "重設連結已發送！"

msgid "Failed to send reset link. Please try again."
msgstr "發送重設連結失敗，請再試一次。"

msgid "If an account exists with this email, a reset link has been sent. Check your inbox."
msgstr "如果呢個電郵有登記帳戶，我哋已經發送咗重設連結，請檢查你嘅收件匣。"

# ===========================================================================
# EVENT ERRORS
# ===========================================================================
msgid "This event is not available for booking"
msgstr "呢個活動而家唔接受預訂"

msgid "This event has already ended"
msgstr "呢個活動已經完咗"

msgid "This event is not available for public booking"
msgstr "呢個活動唔開放俾公眾預訂"

msgid "Event not found"
msgstr "搵唔到呢個活動"

msgid "Event has ended"
msgstr "活動已經完咗"

msgid "You do not have permission to create events."
msgstr "你冇權建立活動。"

msgid "Invalid event_flow: {value!r}. Valid values: {valid}."
msgstr "活動流程唔啱：{value!r}。可用值：{valid}。"

msgid "start_date and end_date are required and must be valid ISO dates."
msgstr "必須填寫開始日期同結束日期，而且要係有效嘅 ISO 日期。"

msgid "Venue not found."
msgstr "搵唔到場地。"

msgid "Policy not found."
msgstr "搵唔到政策。"

msgid "You can only attach your own cancellation policies."
msgstr "你只可以附加自己嘅取消政策。"

msgid "Organizer not found."
msgstr "搵唔到主辦方。"

msgid "The selected user is not an organizer."
msgstr "所選用戶唔係主辦方。"

msgid "Could not create event: {exc}"
msgstr "建立活動失敗：{exc}"

msgid "Event was created but the response could not be serialized: {exc}"
msgstr "活動已建立，但係回應無法序列化：{exc}"

msgid "Permission denied"
msgstr "權限不足"

msgid "Cannot edit past events"
msgstr "唔可以編輯過咗期嘅活動"

msgid "Cannot delete past events"
msgstr "唔可以刪除過咗期嘅活動"

msgid "Cannot publish past events"
msgstr "唔可以發佈過咗期嘅活動"

msgid "Cannot change event flow: {count} active booking(s) exist. Cancel them first."
msgstr "無法更改活動流程：仲有 {count} 個有效預訂。請先取消佢哋。"

msgid "Cannot reassign an event that has {count} active booking(s). Cancel or refund them first."
msgstr "無法重新分配有 {count} 個有效預訂嘅活動。請先取消或退款。"

msgid "Cannot delete session {id}: it has {count} booked seat(s). Cancel or reassign those bookings first."
msgstr "無法刪除時段 {id}：已經有 {count} 個座位被預訂。請先取消或重新分配相關預訂。"

msgid "Cannot delete session {id}: existing tickets reference it."
msgstr "無法刪除時段 {id}：已經有門票引用呢個時段。"

msgid "Cannot delete tier \"{name}\": it has {count} sold ticket(s). Cancel those tickets first."
msgstr "無法刪除票種「{name}」：已經賣出 {count} 張門票。請先取消嗰啲門票。"

msgid "Cannot delete tier \"{name}\": existing tickets reference it."
msgstr "無法刪除票種「{name}」：已經有門票引用呢個票種。"

msgid "Free registration events cannot have priced tiers. Tier #{index} has price {price}."
msgstr "免費登記活動唔可以有收費票種。票種 #{index} 嘅價格係 {price}。"

msgid "Only administrators can assign an event to another organizer."
msgstr "只有管理員先可以將活動分配俾其他主辦方。"

msgid "Invalid event_flow. Must be one of {valid}."
msgstr "活動流程唔啱，必須係以下其中之一：{valid}。"

